# syntax=docker/dockerfile:1
# Image untuk Vercel Container Runtime: Laravel di atas FrankenPHP (PHP 8.4).
# Dibangun otomatis oleh Vercel saat deploy; tidak perlu Docker di laptop.

# ---------- 1. Aset front-end (Vite, Tailwind, Three.js, GSAP) ----------
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY vite.config.js ./
COPY resources ./resources
COPY public ./public
RUN npm run build

# ---------- 2. Basis PHP ----------
FROM dunglas/frankenphp:1-php8.4-bookworm AS base
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions pdo_pgsql intl zip bcmath opcache \
    && { \
        echo 'opcache.enable=1'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.max_accelerated_files=20000'; \
        echo 'memory_limit=256M'; \
        echo 'upload_max_filesize=8M'; \
        echo 'post_max_size=10M'; \
        echo 'expose_php=Off'; \
    } > "$PHP_INI_DIR/conf.d/zz-asri.ini"
WORKDIR /app

# ---------- 3. Dependensi Composer ----------
FROM base AS vendor
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --prefer-dist --optimize-autoloader
COPY . .
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative --no-scripts

# ---------- 4. Image akhir ----------
FROM base AS runtime
COPY --from=vendor /app /app
COPY --from=assets /app/public/build /app/public/build
COPY Caddyfile /etc/frankenphp/Caddyfile

# Filesystem Vercel hanya-baca kecuali /tmp, jadi semua yang ditulis Laravel diarahkan ke /tmp.
# Nilai rahasia (APP_KEY, kredensial Neon, dll.) diisi di Environment Variables Vercel.
ENV PORT=80 \
    XDG_CONFIG_HOME=/tmp/caddy/config \
    XDG_DATA_HOME=/tmp/caddy/data \
    APP_ENV=production \
    APP_DEBUG=false \
    APP_LOCALE=id \
    APP_FALLBACK_LOCALE=en \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=warning \
    DB_CONNECTION=pgsql \
    DB_SSLMODE=require \
    SESSION_DRIVER=cookie \
    SESSION_SECURE_COOKIE=true \
    CACHE_STORE=array \
    QUEUE_CONNECTION=sync \
    BROADCAST_CONNECTION=log \
    MAIL_MAILER=log \
    FILESYSTEM_PUBLIC_ROOT=/tmp/storage/public \
    VIEW_COMPILED_PATH=/tmp/views \
    APP_CONFIG_CACHE=/tmp/laravel/config.php \
    APP_EVENTS_CACHE=/tmp/laravel/events.php \
    APP_PACKAGES_CACHE=/tmp/laravel/packages.php \
    APP_ROUTES_CACHE=/tmp/laravel/routes.php \
    APP_SERVICES_CACHE=/tmp/laravel/services.php

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
